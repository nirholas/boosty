{
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nirholas/boosty.git"
  },
  "name": "boosty-mcp",
  "version": "1.0.1",
  "private": true,
  "description": "Boosty MCP servers for DeFi - Volume generation, trading, and wallet management",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @boosty/mcp-server dev",
    "start": "pnpm --filter @boosty/mcp-server start",
    "db:init": "pnpm --filter @boosty/mcp-server db:init",
    "db:migrate": "pnpm --filter @boosty/mcp-server db:migrate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@1": "^1.14.5",
      "@hono/node-server@1": "^2.1.3",
      "@vitest/mocker@2": "^4.1.12",
      "body-parser@1": "^1.20.9",
      "body-parser@2": "^2.4.0",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "drizzle-orm@0.29": "~0.45.2",
      "esbuild@0.18": "~0.25.0",
      "esbuild@0.19": "~0.25.0",
      "esbuild@0.21": "~0.25.0",
      "esbuild@0.27": "~0.28.1",
      "fast-copy@3": "^3.1.0",
      "fast-uri@2": "^2.4.8",
      "fast-uri@3": "^3.1.9",
      "fastify@4": "^5.12.5",
      "find-my-way@8": "^9.7.0",
      "handlebars@4": "^4.7.10",
      "hono@4": "^4.13.11",
      "ip-address@10": "^10.7.4",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "minimatch@9": "^11.0.1",
      "protobufjs@6": "^7.6.3",
      "proxy-addr@2": "^2.0.8",
      "qs@6": "^6.16.1",
      "sharp@0.32": "~0.35.5",
      "source-map-js@1": "^1.2.2",
      "tinypool@0.8": "^2.1.2",
      "tinypool@1": "^2.1.2",
      "toml@3": "^5.0.1",
      "uuid@10": "^11.1.1",
      "uuid@8": "^11.1.1",
      "uuid@9": "^11.1.1",
      "vite@5": "^6.4.4",
      "vitest@1": "^4.1.11",
      "vitest@2": "^4.1.11",
      "jayson@4": "^5.0.0",
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
      "mongoose@8": "^8.24.8"
    }
  }
}
