{
  "name": "@boosty/mcp-server",
  "version": "1.0.0",
  "description": "Production DeFi operations MCP server for Solana with wallet management, trading, and volume campaigns",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "defi-mcp-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:init": "node dist/cli.js db:init",
    "db:migrate": "node dist/cli.js db:migrate"
  },
  "dependencies": {
    "@boosty/mcp-orchestrator": "workspace:*",
    "@boosty/mcp-shared": "workspace:*",
    "@boosty/mcp-trading-engine": "workspace:*",
    "@boosty/mcp-wallet-manager": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@solana/web3.js": "^1.98.4",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "viem": "^2.55.10",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/svm": "^2.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "defi",
    "solana",
    "trading",
    "wallets",
    "volume-generation"
  ],
  "license": "MIT"
}
